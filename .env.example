# Database
DB_HOST=db
DB_PORT=3306
DB_USER=romadmin
DB_PASSWORD=changeme
DB_NAME=romadmin
DB_ROOT_PASSWORD=rootchangeme
DATABASE_URL=mysql://romadmin:changeme@db:3306/romadmin

# App
PORT=3000
NODE_ENV=production

# CORS (optional – restricts API access to a specific origin, e.g. http://localhost:3000)
# CORS_ORIGIN=http://localhost:3000

# Paths (inside container)
ROM_PATH=/roms
SAVE_PATH=/saves
MEDIA_PATH=/media

# NAS (SMB/CIFS mount for ROM library)
NAS_HOST=your-nas-ip
NAS_USER=your-nas-user
NAS_PASSWORD=changeme
NAS_SHARE=your-share-name
